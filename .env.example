# =============================================================================
# Finance Controller — Environment Configuration (Template)
# =============================================================================
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# Database connection string (REQUIRED)
# ---------------------------------------------------------------------------
# Use the "postgresql+psycopg2://" scheme so SQLAlchemy picks psycopg2-binary.
#
# Neon (recommended for the ideathon demo):
#   DATABASE_URL=postgresql+psycopg2://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#
# Local PostgreSQL:
#   DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/finance_controller
#
# SQLite fallback (no external DB required — omit DATABASE_URL or set it explicitly):
#   DATABASE_URL=sqlite:///./finance_controller.db
#
DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require

# Database pool settings (PostgreSQL only — ignored for SQLite)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO_SQL=false

# AI Investigation API Key (optional — structured reasoning fallback works without it)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
