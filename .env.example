# =============================================================================
# Finance Controller — Environment Configuration (Template)
# =============================================================================
# Copy this file to .env and fill in your values.

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/finance_controller

# Database pool settings (optional)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO_SQL=false

# AI Investigation API Key (optional — structured reasoning fallback works without it)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
